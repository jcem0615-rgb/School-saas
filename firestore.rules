rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function claims() {
      return request.auth.token;
    }

    function isOwner() {
      return isSignedIn() && claims().role == 'owner';
    }

    function belongsToSchool(schoolId) {
      return isSignedIn() && claims().schoolId == schoolId;
    }

    function hasRole(schoolId, roles) {
      return belongsToSchool(schoolId) && claims().role in roles;
    }

    function isAccountActive() {
      return isSignedIn() && claims().status == 'active';
    }

    // Reads the school's live subscription status. Used to lock out a
    // suspended school's data even if the user's ID token hasn't expired
    // yet (claims are cached client-side up to an hour) -- billing status
    // is checked fresh on every request via get(), not trusted from claims.
    function schoolIsAccessible(schoolId) {
      let sub = get(/databases/$(database)/documents/platform_subscriptions/$(schoolId)).data;
      return sub.currentStatus != 'suspended';
    }

    // Whitelist of fields a user may change on their OWN profile doc.
    // Role, schoolId, status, and mustChangePassword can never be touched
    // by the client -- those only ever change via Cloud Functions running
    // with Admin privileges (see functions/src/callable/users/*).
    function onlySelfEditableFieldsChanged() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      // privacyNoticeVersion/-AcknowledgedAt are here rather than behind a
      // callable because acknowledging a notice is a person asserting
      // something about themselves. What matters is that they cannot
      // assert it about anybody else, which the uid check above already
      // guarantees.
      // termsVersion/-AcceptedAt for the same reason as the two above it:
      // accepting an agreement is a person asserting something about
      // themselves, and the uid check already guarantees they cannot
      // assert it about anybody else.
      return affected.hasOnly([
        'phone', 'photoUrl', 'privacySettings', 'updatedAt', 'updatedBy',
        'privacyNoticeVersion', 'privacyNoticeAcknowledgedAt',
        'termsVersion', 'termsAcceptedAt',
      ]);
    }

    // -------------------------------------------------------------------
    // Division / department isolation.
    //
    // A school can run Elementary, High School, and College under one
    // tenant. Every students/{id} record has `educationLevel` (required)
    // and, for College students, a denormalized `department` (set once at
    // registration from their program -- see registerStudent.ts -- so
    // this never needs an extra join at read time).
    //
    // A staff member's OWN scope lives on their user doc at
    // `employeeInfo.assignedDivision` / `employeeInfo.assignedDepartment`,
    // both OPTIONAL: left unset, the staff member keeps their role's
    // normal cross-division access (this is what keeps every school/test
    // that never configures this working exactly as before). Set it, and
    // access is actually restricted -- not just hidden in the UI.
    //
    // Firestore caches get()/exists() results per document path for the
    // duration of a single rule evaluation, so calling get() on the same
    // path from multiple OR branches below (e.g. both a "self" check and
    // a "same division" check reading the same students/{id} doc) does
    // not multiply cost or risk the ~10-call-per-request budget.
    // -------------------------------------------------------------------

    function staffEmployeeInfo(schoolId) {
      let path = /databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid);
      // get() on a nonexistent document throws in Firestore rules (unlike
      // exists(), which safely returns false) -- guard against that so a
      // caller whose own profile doc isn't found is treated the same as
      // "no scope configured" (unrestricted) rather than erroring the
      // whole branch out. In practice this only matters for the instant
      // between account creation and the profile doc write, but it's the
      // correct defensive default regardless.
      return exists(path) ? get(path).data.get('employeeInfo', {}) : {};
    }

    // true if the CALLER's own assigned scope permits access to a student
    // with the given [studentDivision]/[studentDepartment]. Unset caller
    // scope (null) means unrestricted, by design -- see comment above.
    function scopeAllowsStudent(schoolId, studentDivision, studentDepartment) {
      let info = staffEmployeeInfo(schoolId);
      let staffDivision = info.get('assignedDivision', null);
      let staffDepartment = info.get('assignedDepartment', null);
      return staffDivision == null
        || (staffDivision == studentDivision
            && (staffDepartment == null || studentDepartment == null || staffDepartment == studentDepartment));
    }

    // Guidance records may be filed against a whole section rather than one
    // student, in which case studentId is absent. Two things matter here:
    //
    //  * `.get('studentId', null)` -- reading an absent field directly
    //    throws in rules, which would deny the whole branch rather than
    //    evaluate false.
    //  * an unscoped record must not become a way around division
    //    scoping. A counsellor with an assignedDivision only ever sees
    //    records tied to a student they are scoped for; section-level
    //    records are visible only to staff who are themselves unscoped
    //    (and to Director/Admin, who are cross-division by design).
    function guidanceScopeAllows(schoolId, studentId) {
      return studentId == null
        ? staffEmployeeInfo(schoolId).get('assignedDivision', null) == null
        : scopeAllowsStudentById(schoolId, studentId);
    }

    // Convenience for rules on collections that reference a student by ID
    // (grades, payments, guidanceRecords, summons) rather than being the
    // student doc itself -- one get() fetches both fields it needs.
    function scopeAllowsStudentById(schoolId, studentId) {
      let student = get(/databases/$(database)/documents/schools/$(schoolId)/students/$(studentId)).data;
      return scopeAllowsStudent(schoolId, student.get('educationLevel', 'elementary'), student.get('department', null));
    }

    // -------------------------------------------------------------------
    // Platform-level data (Owner only) -- schools registry, subscriptions,
    // invoices, owner audit log. No tenant user may ever read or write here.
    // -------------------------------------------------------------------

    match /platform_schools/{schoolId} {
      allow read, write: if isOwner();
    }

    match /platform_subscriptions/{schoolId} {
      allow read, write: if isOwner();
    }

    match /platform_invoices/{invoiceId} {
      allow read, write: if isOwner();
    }

    // Where bootstrapOwner records that the owner role has been claimed.
    // Server-written only: a client that could create this doc could lock
    // the owner out before they ever claimed it, and one that could
    // delete it could re-open the door and hand the role to a second
    // account. The Owner can read it to see when and by whom.
    match /platform_config/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /platform_owner_audit_log/{logId} {
      // Immutable even for the Owner from the client; written only by
      // Cloud Functions via the Admin SDK, which bypasses these rules.
      allow read: if isOwner();
      allow write: if false;
    }

    match /platform_owner_profiles/{uid} {
      allow read: if isOwner() && request.auth.uid == uid;
      allow write: if false; // provisioned only via Admin SDK / console
    }

    // Denormalized dashboard metrics maintained by dailyBillingJob --
    // read-only from the client even for the Owner, since a corrupted
    // client write here would silently mislead revenue reporting.
    match /platform_revenue_summary/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // -------------------------------------------------------------------
    // Tenant-scoped data: schools/{schoolId}/**
    // Path-level isolation: a rule bug elsewhere cannot leak cross-tenant
    // because every tenant collection physically lives under its own
    // schools/{schoolId} document.
    // -------------------------------------------------------------------

    match /schools/{schoolId} {

      // The school's own profile doc (name, logo, contact info) --
      // readable by anyone in the tenant, writable only by school admins;
      // billing-relevant fields (billingRatePerStudent) are Owner-only and
      // live in platform_schools instead, never here.
      allow read: if belongsToSchool(schoolId);
      allow write: if hasRole(schoolId, ['director', 'admin']);

      // ---- users ----
      match /users/{userId} {
        // Always readable regardless of subscription status -- a
        // suspended school's users must still be able to see their own
        // profile so the app can render a "school suspended" notice
        // instead of a blank/broken screen.
        allow read: if belongsToSchool(schoolId);

        // Self-service edits: limited fields only, and only while active
        // AND the school itself is not suspended.
        allow update: if belongsToSchool(schoolId)
                        && request.auth.uid == userId
                        && isAccountActive()
                        && schoolIsAccessible(schoolId)
                        && onlySelfEditableFieldsChanged();

        // HR-style edits by admin roles: allowed on non-security fields;
        // security-sensitive fields (role, status, mustChangePassword,
        // schoolId) are still excluded here too -- those require the
        // dedicated callable functions so every role change is audited.
        allow update: if hasRole(schoolId, ['director', 'admin'])
                        && schoolIsAccessible(schoolId)
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasAny(['role', 'schoolId', 'status', 'mustChangePassword']);

        // Creation and hard security-field changes only via Admin SDK
        // (provisionUser, resetPasswordAdmin, clearForcePasswordChangeFlag).
        allow create, delete: if false;

        // ---- push notification device tokens ----
        // One document per device, keyed BY the token, so registering the
        // same browser twice overwrites rather than accumulates.
        //
        // A subcollection rather than a field on the user document, and
        // this is the reason: users/{userId} is readable by everyone in
        // the school (see `allow read` above), so a token stored there
        // would let any colleague read it -- and anyone holding a token
        // can push notifications to that device. Here, only the owner can
        // read or write their own. The fan-out in
        // onAnnouncementCreated.ts uses the Admin SDK, which bypasses
        // rules entirely.
        match /deviceTokens/{token} {
          allow read, write: if belongsToSchool(schoolId)
                               && request.auth.uid == userId;
        }
      }

      // ---- audit log: append-only from server, read-only from client ----
      match /auditLog/{logId} {
        // Admin-tier roles see the full school audit trail; every other
        // user can see only their own actions ("My Activity History" --
        // a General Requirement for every role per the spec, distinct
        // from the full Audit Trail screen Owner/Director/Admin get).
        allow read: if hasRole(schoolId, ['owner', 'director', 'admin'])
                      || (belongsToSchool(schoolId) && schoolIsAccessible(schoolId) && resource.data.userId == request.auth.uid);
        allow write: if false;
      }

      // ---- announcements ----
      match /announcements/{announcementId} {
        allow read: if belongsToSchool(schoolId) && schoolIsAccessible(schoolId);

        // Faculty may post too, but only as themselves. A teacher's
        // notice is addressed to a class they take, and the audience is
        // targeting rather than access control (see AnnouncementAudience)
        // -- so what actually has to be enforced here is authorship, not
        // who the notice is for.
        allow create: if schoolIsAccessible(schoolId)
                        && request.resource.data.createdBy == request.auth.uid
                        && hasRole(schoolId, ['director', 'principal', 'admin', 'faculty']);

        // Only the base envelope + content fields may change; no swapping
        // authorship after the fact. A teacher may edit only their own;
        // the three management roles may edit any, which is what lets a
        // director correct or retract a notice.
        allow update: if schoolIsAccessible(schoolId)
                        && request.resource.data.createdBy == resource.data.createdBy
                        && (
                          hasRole(schoolId, ['director', 'principal', 'admin'])
                          || (hasRole(schoolId, ['faculty'])
                              && resource.data.createdBy == request.auth.uid)
                        );
        allow delete: if false; // soft delete only, via update
      }

      // ---- meetings ----
      match /meetings/{meetingId} {
        allow read: if belongsToSchool(schoolId) && schoolIsAccessible(schoolId);
        allow create: if hasRole(schoolId, ['director', 'principal', 'admin']) && schoolIsAccessible(schoolId);
        allow update: if hasRole(schoolId, ['director', 'principal', 'admin'])
                        && schoolIsAccessible(schoolId)
                        && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if false;
      }

      // ---- approvals ----
      // Any active tenant member may FILE a request (e.g. a Staff member's
      // material request); only Director/Principal/Admin may DECIDE it.
      // This is why create and update have deliberately different role
      // gates. Principal's decide-rights are NOT division-scoped here --
      // approvals (material requests, promissory notes) don't carry a
      // denormalized division/department the way students/grades/payments
      // do, and adding that would need a larger redesign; documented as a
      // deliberate, reasoned boundary in docs/16-principal-role.md rather
      // than a silent gap.
      match /approvals/{approvalId} {
        allow read: if belongsToSchool(schoolId) && schoolIsAccessible(schoolId);
        allow create: if belongsToSchool(schoolId)
                        && isAccountActive()
                        && schoolIsAccessible(schoolId)
                        && request.resource.data.requestedByRole == claims().role
                        && request.resource.data.status == 'pending';
        // The decision has to be signed by the account making it. Without
        // this a decider could write any name into decidedByName, and the
        // approval history -- which exists to answer "who approved this?"
        // -- would answer with whatever the client typed. The same shape
        // as the authorship check on create.
        allow update: if hasRole(schoolId, ['director', 'principal', 'admin'])
                        && schoolIsAccessible(schoolId)
                        && resource.data.status == 'pending'
                        && request.resource.data.status in ['approved', 'rejected']
                        && request.resource.data.decidedByUid == request.auth.uid
                        && request.resource.data.decidedByRole == claims().role;
        allow delete: if false;
      }

      // ---- paymentSubmissions ----
      // A family's claim that they sent money online. Deliberately NOT a
      // payment: this collection moves no balance, which is exactly why a
      // student or parent is allowed to write to it at all.
      //
      // The balance only changes when decidePaymentSubmission (Admin SDK)
      // approves one, so the worst a bogus submission can do is waste a
      // cashier's time -- not credit an account.
      match /paymentSubmissions/{submissionId} {
        allow read: if schoolIsAccessible(schoolId)
                      && (
                        hasRole(schoolId, ['director', 'admin', 'registrar'])
                        // The submitter can follow their own claim through
                        // to its decision rather than having to ask.
                        || resource.data.createdBy == request.auth.uid
                        || (claims().role == 'parent'
                            && resource.data.studentId in
                               get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.linkedStudentIds)
                      );

        // Families file their own; a cashier may also file one on their
        // behalf (e.g. a walk-in showing a phone screenshot).
        allow create: if schoolIsAccessible(schoolId)
                        && isAccountActive()
                        && request.resource.data.createdBy == request.auth.uid
                        // Cannot be filed pre-approved -- approval is a
                        // decision, never an input.
                        && request.resource.data.status == 'pending'
                        && request.resource.data.amount is number
                        && request.resource.data.amount > 0
                        && request.resource.data.referenceNumber is string
                        && request.resource.data.referenceNumber.size() > 0
                        && (
                          hasRole(schoolId, ['director', 'admin', 'registrar'])
                          || (claims().role == 'student'
                              && get(/databases/$(database)/documents/schools/$(schoolId)/students/$(request.resource.data.studentId)).data.userId == request.auth.uid)
                          || (claims().role == 'parent'
                              && request.resource.data.studentId in
                                 get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.linkedStudentIds)
                        );

        // No client update path at all: deciding runs through the callable
        // so the payment and the status change happen in one transaction.
        // A family editing their own pending claim would also let them
        // change the amount after a cashier had started checking it.
        allow update, delete: if false;
      }

      // ---- settings (payment QR and account details) ----
      // One document, school-wide. Everyone needs to read it -- a family
      // cannot pay without it -- but only the roles that handle money may
      // change where money is sent. Pointing the QR at another account
      // would be the single most damaging write in this system.
      match /settings/{settingId} {
        allow read: if belongsToSchool(schoolId) && schoolIsAccessible(schoolId);
        allow write: if hasRole(schoolId, ['director', 'admin', 'registrar'])
                       && schoolIsAccessible(schoolId);
      }

      // ---- expenses ----
      // Financial data: visible to the roles that manage school finances,
      // not to every tenant member the way announcements/meetings are.
      match /expenses/{expenseId} {
        allow read: if hasRole(schoolId, ['director', 'admin', 'registrar']) && schoolIsAccessible(schoolId);
        allow create: if hasRole(schoolId, ['director', 'admin']) && schoolIsAccessible(schoolId);
        allow update: if hasRole(schoolId, ['director', 'admin'])
                        && schoolIsAccessible(schoolId)
                        && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if false;
      }

      // ---- teacherAssignments ----
      match /teacherAssignments/{assignmentId} {
        allow read: if hasRole(schoolId, ['director', 'principal', 'admin', 'registrar', 'faculty']) && schoolIsAccessible(schoolId);
        allow create: if hasRole(schoolId, ['director', 'principal', 'admin']) && schoolIsAccessible(schoolId);
        allow update: if hasRole(schoolId, ['director', 'principal', 'admin'])
                        && schoolIsAccessible(schoolId)
                        && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if false;
      }

      // ---- dataRequests (what a person asked the school to do with
      // their own information) ----
      //
      // Anybody in the school may raise one about themselves, and a
      // parent about a linked child. That is the point: a right nobody
      // can exercise without finding the right office is a right on
      // paper only.
      //
      // Only the office may close one, and the close is an update rather
      // than a delete -- a school asked how it handles these has to be
      // able to show the ones it refused as well as the ones it granted.
      match /dataRequests/{requestId} {
        allow read: if belongsToSchool(schoolId)
                      && schoolIsAccessible(schoolId)
                      && (
                        hasRole(schoolId, ['director', 'admin', 'registrar'])
                        || resource.data.requestedByUid == request.auth.uid
                      );

        allow create: if belongsToSchool(schoolId)
                        && schoolIsAccessible(schoolId)
                        && isAccountActive()
                        && request.resource.data.requestedByUid == request.auth.uid
                        && request.resource.data.status == 'open'
                        // Nobody files a request that arrives already
                        // answered.
                        && request.resource.data.handledByName == null
                        && request.resource.data.outcome == null;

        allow update: if hasRole(schoolId, ['director', 'admin', 'registrar'])
                        && schoolIsAccessible(schoolId)
                        // The request itself is what was asked; only the
                        // answer may change.
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasAny(['requestedByUid', 'requestedByName', 'kind',
                                       'details', 'requestedAt', 'studentId']);

        allow delete: if false;
      }

      // ---- scheduleBlocks (the weekly timetable) ----
      //
      // Readable by the whole tenant, and deliberately so: a timetable
      // is posted on the classroom wall. A student needs their own
      // week, a parent needs to know when their child is in school, and
      // a teacher covering a class needs somebody else's slot. Scoping
      // it per division would buy nothing and would stop a student
      // seeing the room their next class is in.
      //
      // No client writes at all. Clash detection -- one teacher, one
      // section, one room, one slot -- is the entire feature, and a
      // guarantee that lives only in the UI is not a guarantee. Both
      // writes go through saveScheduleBlock and deleteScheduleBlock.
      match /scheduleBlocks/{blockId} {
        allow read: if belongsToSchool(schoolId) && schoolIsAccessible(schoolId);
        allow write: if false;
      }

      // ---- courseworkItems (Lesson Plans, Lessons, Assignments, Projects, Exams, Quizzes) ----
      match /courseworkItems/{itemId} {
        // Published items are visible to the whole tenant (students/
        // parents consume these in the Student Portal module); unpublished
        // drafts are visible only to staff and the owning teacher, so a
        // Faculty member can save a draft without it appearing in a
        // school-wide feed prematurely.
        allow read: if belongsToSchool(schoolId)
                      && schoolIsAccessible(schoolId)
                      && (
                        resource.data.published == true
                        || hasRole(schoolId, ['director', 'principal', 'admin', 'faculty', 'registrar', 'guidance'])
                      );
        allow create: if hasRole(schoolId, ['faculty', 'director', 'admin'])
                        && schoolIsAccessible(schoolId)
                        && request.resource.data.teacherId == request.auth.uid;
        allow update: if schoolIsAccessible(schoolId)
                        && (resource.data.teacherId == request.auth.uid || hasRole(schoolId, ['director', 'principal', 'admin']))
                        && request.resource.data.teacherId == resource.data.teacherId;
        allow delete: if false;
      }

      // ---- emergencyContacts: the numbers on the wall ----
      //
      // Readable by every role in the school, with no scoping at all.
      // That is unusual here and it is the point: a number a student
      // cannot reach during a fire is not a safety feature. Nothing in
      // this collection is personal data -- it is what a school prints on
      // a poster by the door.
      match /emergencyContacts/{contactId} {
        allow read: if belongsToSchool(schoolId);
        allow create, update: if schoolIsAccessible(schoolId)
                                && hasRole(schoolId, ['director', 'principal', 'admin']);
        allow delete: if false; // soft delete only
      }

      // ---- emergencyAlerts: a student pressing the button ----
      match /emergencyAlerts/{alertId} {
        // The student who raised it, their linked parents, and staff.
        // Staff read the whole collection because someone has to be able
        // to see an alert they were not personally addressed by -- and
        // because Firestore rules reject queries rather than filtering
        // them, a narrower rule would fail the staff list entirely.
        allow read: if belongsToSchool(schoolId)
                      && (
                        resource.data.userId == request.auth.uid
                        || claims().role in ['director', 'principal', 'admin', 'registrar', 'faculty', 'staff', 'guidance']
                        || (claims().role == 'parent'
                            && resource.data.studentId in
                               get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.linkedStudentIds)
                      );

        // Raised by a student, as themselves, on the server's clock.
        //
        // Note there is no schoolIsAccessible() check here, unlike
        // everywhere else in this file. A school whose subscription has
        // lapsed still has children in it; billing is not a reason to
        // drop an emergency alert on the floor.
        allow create: if belongsToSchool(schoolId)
                        && claims().role == 'student'
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.raisedAt == request.time;

        // Staff acknowledge and resolve. The student cannot edit their
        // own alert afterwards -- an alert that can be quietly retracted
        // is worth less than one that cannot.
        // The location is in the immutable set with everything else the
        // student wrote. Where they said they were when they called for
        // help is evidence; staff acknowledging an alert must not be able
        // to move it, and nor should a later edit be able to quietly
        // erase it.
        allow update: if belongsToSchool(schoolId)
                        && claims().role in ['director', 'principal', 'admin', 'registrar', 'faculty', 'staff', 'guidance']
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['userId', 'studentId', 'section', 'message', 'raisedAt',
                                       'latitude', 'longitude', 'locationAccuracyMeters',
                                       'locationFailure']);

        allow delete: if false;
      }

      // ---- courseworkAnswerKeys: the correct answers ----
      //
      // Kept out of courseworkItems on purpose. Students read coursework
      // items -- that is how they see the assignment -- so an answer key
      // stored there would be an answer key handed to the class.
      //
      // There is no student branch on this read rule and there must never
      // be one. The count of questions lives on the coursework item,
      // which is all a student's form needs to draw its boxes.
      match /courseworkAnswerKeys/{courseworkId} {
        allow read: if belongsToSchool(schoolId)
                      && schoolIsAccessible(schoolId)
                      && claims().role in ['director', 'principal', 'admin', 'faculty'];
        allow create, update: if schoolIsAccessible(schoolId)
                                && hasRole(schoolId, ['faculty', 'director', 'principal', 'admin']);
        allow delete: if false;
      }

      // ---- courseworkSubmissions: what students hand in ----
      //
      // The one collection in this schema a student writes to. Everything
      // else they touch is read-only, so the rules here carry more weight
      // than usual.
      //
      // Ownership is anchored on userId == request.auth.uid, never on
      // studentId: a studentId is a record identifier anyone could type,
      // while the uid is the one field the client cannot forge.
      match /courseworkSubmissions/{submissionId} {
        // A student reads their own; staff read everything, because a
        // teacher marking work needs the whole class and Firestore rules
        // reject queries rather than filtering them -- a per-document
        // teacher check would fail the whole "submissions for this item"
        // query. A parent reads their linked children's.
        allow read: if belongsToSchool(schoolId)
                      && schoolIsAccessible(schoolId)
                      && (
                        resource.data.userId == request.auth.uid
                        || claims().role in ['director', 'principal', 'admin', 'faculty', 'registrar', 'guidance']
                        || (claims().role == 'parent'
                            && resource.data.studentId in
                               get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.linkedStudentIds)
                      );

        // Students only, and only as themselves. submittedAt must be the
        // server's clock: whether work arrived before a deadline is
        // exactly the field a student has a motive to shade, and a
        // client-supplied timestamp would make the late flag meaningless.
        //
        // No score field of any kind may come from the client. Marking
        // runs server-side in onCourseworkSubmissionWritten, using a key
        // the student cannot read -- a client-computed score is just a
        // student writing their own mark.
        allow create: if schoolIsAccessible(schoolId)
                        && isAccountActive()
                        && claims().role == 'student'
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.submittedAt == request.time
                        && request.resource.data.answer is string
                        && !request.resource.data.keys()
                              .hasAny(['autoScore', 'correctCount', 'score', 'feedback', 'gradedByName', 'gradedAt']);

        // Revising an answer. The original submittedAt is immutable --
        // rewriting it would let a late submission relabel itself as
        // on time -- and ownership cannot be reassigned.
        allow update: if schoolIsAccessible(schoolId)
                        && isAccountActive()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.studentId == resource.data.studentId
                        && request.resource.data.courseworkId == resource.data.courseworkId
                        && request.resource.data.submittedAt == resource.data.submittedAt
                        && request.resource.data.updatedAt == request.time
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['autoScore', 'correctCount', 'score', 'feedback', 'gradedByName', 'gradedAt']);

        // A teacher marking the work. The mirror image of the student
        // rule: they may touch the score fields and nothing else, so
        // grading can never quietly rewrite what was handed in.
        allow update: if schoolIsAccessible(schoolId)
                        && hasRole(schoolId, ['faculty', 'director', 'principal', 'admin'])
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['userId', 'studentId', 'courseworkId', 'answer', 'answers',
                                       'attachmentUrl', 'submittedAt', 'autoScore', 'correctCount']);

        // Handed-in work is not something the student who handed it in
        // gets to make disappear.
        allow delete: if false;
      }

      // ---- grades ----
      match /grades/{gradeId} {
        allow read: if belongsToSchool(schoolId)
                      && schoolIsAccessible(schoolId)
                      && (
                        hasRole(schoolId, ['director', 'admin'])
                        || (hasRole(schoolId, ['principal', 'registrar', 'faculty', 'guidance'])
                            && scopeAllowsStudentById(schoolId, resource.data.studentId))
                        || get(/databases/$(database)/documents/schools/$(schoolId)/students/$(resource.data.studentId)).data.userId == request.auth.uid
                        || (claims().role == 'parent'
                            && resource.data.studentId in
                               get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.linkedStudentIds)
                      );
        allow create: if schoolIsAccessible(schoolId)
                        && (
                          hasRole(schoolId, ['director', 'admin'])
                          || (hasRole(schoolId, ['faculty'])
                              && scopeAllowsStudentById(schoolId, request.resource.data.studentId))
                        );
        allow update: if schoolIsAccessible(schoolId)
                        && request.resource.data.studentId == resource.data.studentId
                        && (
                          hasRole(schoolId, ['director', 'admin'])
                          || (hasRole(schoolId, ['faculty']) && scopeAllowsStudentById(schoolId, resource.data.studentId))
                        );
        allow delete: if false;
      }

      // ---- documentReleases ----
      // The log of TORs and Form 137s handed over the counter.
      //
      // Append-only, and that is the whole point of it. A release record
      // exists to answer "when did this student's records leave the
      // office, and to whom" -- a question a school is genuinely asked,
      // sometimes years later and sometimes by a division office. A log
      // that could be edited or deleted afterwards answers nothing, so
      // there is no update rule and no delete rule for anyone, the
      // Director included.
      //
      // Readable by the student and their parents as well as the office.
      // It is a record of what the school did with their documents, and
      // a family that cannot see it has to phone up to ask.
      match /documentReleases/{releaseId} {
        allow read: if belongsToSchool(schoolId)
                      && schoolIsAccessible(schoolId)
                      && (
                        hasRole(schoolId, ['director', 'admin'])
                        || (hasRole(schoolId, ['principal', 'registrar'])
                            && scopeAllowsStudentById(schoolId, resource.data.studentId))
                        || get(/databases/$(database)/documents/schools/$(schoolId)/students/$(resource.data.studentId)).data.userId == request.auth.uid
                        || (claims().role == 'parent'
                            && resource.data.studentId in
                               get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.linkedStudentIds)
                      );
        // Pinned to the caller: a log entry naming somebody else as the
        // person who released the document would be worse than no log.
        allow create: if schoolIsAccessible(schoolId)
                        && request.resource.data.releasedBy == request.auth.uid
                        && (
                          hasRole(schoolId, ['director', 'admin'])
                          || (hasRole(schoolId, ['registrar'])
                              && scopeAllowsStudentById(schoolId, request.resource.data.studentId))
                        );
        allow update, delete: if false;
      }

      // ---- checklistItems (Staff Portal) ----
      match /checklistItems/{itemId} {
        allow read: if schoolIsAccessible(schoolId)
                      && (resource.data.staffId == request.auth.uid || hasRole(schoolId, ['director', 'admin']));
        allow create: if hasRole(schoolId, ['staff', 'director', 'admin'])
                        && schoolIsAccessible(schoolId)
                        && request.resource.data.staffId == request.auth.uid;
        allow update: if schoolIsAccessible(schoolId)
                        && (resource.data.staffId == request.auth.uid || hasRole(schoolId, ['director', 'admin']))
                        && request.resource.data.staffId == resource.data.staffId;
        allow delete: if false;
      }

      // ---- dailyReports (Staff Portal) ----
      // Immutable once submitted -- a daily work log is a point-in-time
      // record; corrections happen via a new entry, not an edit, so the
      // history stays trustworthy. No update rule at all, not even for
      // the author.
      match /dailyReports/{reportId} {
        allow read: if schoolIsAccessible(schoolId)
                      && (resource.data.staffId == request.auth.uid || hasRole(schoolId, ['director', 'admin']));
        allow create: if hasRole(schoolId, ['staff', 'director', 'admin'])
                        && schoolIsAccessible(schoolId)
                        && request.resource.data.staffId == request.auth.uid;
        allow update, delete: if false;
      }

      // ---- guidanceRecords (Guidance Portal) ----
      // Confidential counseling notes -- deliberately the most restrictive
      // read rule in the whole schema. NOT visible to the student it's
      // about, NOT visible to their parent, NOT visible to Faculty or
      // Registrar. Guidance/Director/Admin, plus Principal for their own
      // division only (division-level welfare oversight) -- Principal
      // gets READ ONLY here, never create/update; authoring a counseling
      // note stays a Guidance Office action. This is a different privacy
      // posture than every other per-student collection (attendance,
      // grades, payments), which is intentional -- see
      // docs/14-staff-guidance-portals.md.
      match /guidanceRecords/{recordId} {
        allow read: if schoolIsAccessible(schoolId)
                      && (
                        hasRole(schoolId, ['director', 'admin'])
                        || (hasRole(schoolId, ['guidance', 'principal'])
                            && guidanceScopeAllows(schoolId, resource.data.get('studentId', null)))
                      );
        allow create: if schoolIsAccessible(schoolId)
                        && (
                          hasRole(schoolId, ['director', 'admin'])
                          || (hasRole(schoolId, ['guidance'])
                              && guidanceScopeAllows(schoolId, request.resource.data.get('studentId', null)))
                        );
        // The subject of a note never moves, whether that subject is a
        // student or a section.
        allow update: if schoolIsAccessible(schoolId)
                        && request.resource.data.get('studentId', null) == resource.data.get('studentId', null)
                        && (
                          hasRole(schoolId, ['director', 'admin'])
                          || (hasRole(schoolId, ['guidance'])
                              && guidanceScopeAllows(schoolId, resource.data.get('studentId', null)))
                        );
        allow delete: if false;
      }

      // ---- summons (Guidance Portal) ----
      // Unlike guidanceRecords, a summons IS visible to the student and
      // their linked parent -- being called to the guidance office is
      // exactly the kind of thing a family needs to know about, even
      // though the underlying counseling notes stay private. Principal
      // gets READ ONLY, same reasoning as guidanceRecords above --
      // issuing/deciding a summons stays a Guidance Office action.
      match /summons/{summonsId} {
        allow read: if schoolIsAccessible(schoolId)
                      && (
                        hasRole(schoolId, ['director', 'admin'])
                        || (hasRole(schoolId, ['guidance', 'principal']) && scopeAllowsStudentById(schoolId, resource.data.studentId))
                        || get(/databases/$(database)/documents/schools/$(schoolId)/students/$(resource.data.studentId)).data.userId == request.auth.uid
                        || (claims().role == 'parent'
                            && resource.data.studentId in
                               get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.linkedStudentIds)
                      );
        allow create: if schoolIsAccessible(schoolId)
                        && (
                          hasRole(schoolId, ['director', 'admin'])
                          || (hasRole(schoolId, ['guidance'])
                              && scopeAllowsStudentById(schoolId, request.resource.data.studentId))
                        );
        allow update: if schoolIsAccessible(schoolId)
                        && request.resource.data.studentId == resource.data.studentId
                        && (
                          hasRole(schoolId, ['director', 'admin'])
                          || (hasRole(schoolId, ['guidance']) && scopeAllowsStudentById(schoolId, resource.data.studentId))
                        );
        allow delete: if false;
      }

      // ---- attendance ----
      // Written ONLY by markAttendance.ts (Admin SDK, bypasses these
      // rules entirely) -- status computation, duplicate-scan handling,
      // and audit logging all need to happen atomically server-side, so
      // there is no client write path here at all, not even for staff.
      match /attendance/{recordId} {
        allow read: if belongsToSchool(schoolId)
                      && schoolIsAccessible(schoolId)
                      && (
                        // the record's own subject -- employees: personId
                        // IS their auth uid; students: personId is their
                        // linked students/{studentId} record, so resolve
                        // that record's userId instead (see
                        // docs/07-qr-attendance.md, "ID space" section).
                        resource.data.personId == request.auth.uid
                        || (resource.data.personRole == 'student'
                            && get(/databases/$(database)/documents/schools/$(schoolId)/students/$(resource.data.personId)).data.userId == request.auth.uid)
                        // staff-facing monitoring roles
                        || claims().role in ['director', 'principal', 'admin', 'registrar', 'faculty', 'staff', 'guidance']
                        // a parent viewing a linked child's record
                        || (claims().role == 'parent'
                            && exists(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid))
                            && resource.data.personId in
                               get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.linkedStudentIds)
                      );
        allow write: if false;
      }

      // ---- students ----
      // Read access mirrors the "self, staff-who-need-it, or linked
      // parent" shape used by attendance and payments for consistency.
      // Director/Admin stay cross-division by design (school-wide admin
      // roles); Registrar/Faculty/Guidance are subject to
      // scopeAllowsStudent -- unrestricted unless their own account has
      // an assignedDivision/assignedDepartment configured.
      match /students/{studentId} {
        allow read: if belongsToSchool(schoolId)
                      && schoolIsAccessible(schoolId)
                      && (
                        hasRole(schoolId, ['director', 'admin'])
                        || (hasRole(schoolId, ['principal', 'registrar', 'faculty', 'guidance'])
                            && scopeAllowsStudent(schoolId, resource.data.get('educationLevel', 'elementary'), resource.data.get('department', null)))
                        || resource.data.userId == request.auth.uid
                        || (claims().role == 'parent'
                            && studentId in
                               get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.linkedStudentIds)
                      );

        // Creation happens only via registerStudent.ts (Admin SDK) --
        // the sequential studentNumber must be generated atomically via
        // the same counter transaction pattern used for receipt numbers,
        // which the client cannot safely replicate.
        allow create: if false;

        // Updates to ordinary record fields (name, gradeLevel, section,
        // guardianContacts, status, photoUrl, ...) are allowed directly
        // from the client for Registrar/Admin/Director. `balance` stays
        // server-only (Payments module's recordPayment/recordRefund
        // transactions are the only writers); `studentNumber` and
        // `userId` stay server-only too (studentNumber is a permanent
        // identifier, userId is only ever set by provisionUser.ts's
        // validated linking step -- a direct client write here could
        // silently attach a student's records to the wrong account).
        allow update: if schoolIsAccessible(schoolId)
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasAny(['balance', 'studentNumber', 'userId', 'schoolId'])
                        && (
                          hasRole(schoolId, ['director', 'admin'])
                          || (hasRole(schoolId, ['registrar'])
                              && scopeAllowsStudent(schoolId, resource.data.get('educationLevel', 'elementary'), resource.data.get('department', null)))
                        );

        allow delete: if false; // soft delete only, via update
      }

      // ---- payments ----
      // Written ONLY by recordPayment.ts / recordRefund.ts -- receipt
      // numbering and balance updates must happen atomically server-side
      // (see docs/08-payments.md), so there is no client write path here.
      match /payments/{paymentId} {
        allow read: if belongsToSchool(schoolId)
                      && schoolIsAccessible(schoolId)
                      && (
                        hasRole(schoolId, ['director', 'admin'])
                        || (hasRole(schoolId, ['registrar']) && scopeAllowsStudentById(schoolId, resource.data.studentId))
                        || get(/databases/$(database)/documents/schools/$(schoolId)/students/$(resource.data.studentId)).data.userId == request.auth.uid
                        || (claims().role == 'parent'
                            && resource.data.studentId in
                               get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.linkedStudentIds)
                      );
        allow write: if false;
      }

      // ---- feeStructures (the school's published fee schedules) ----
      // Readable tenant-wide, like programs: a fee schedule is
      // institutional configuration a family is entitled to see, and the
      // student portal shows it beside what they were actually charged.
      // Only Director/Admin publish it -- a registrar assesses fees but
      // does not decide what they are.
      match /feeStructures/{structureId} {
        allow read: if belongsToSchool(schoolId) && schoolIsAccessible(schoolId);
        allow create, update: if hasRole(schoolId, ['director', 'admin'])
                                && schoolIsAccessible(schoolId);
        // Retired by setting isActive, never removed: every assessment
        // that cites a schedule has to stay readable.
        allow delete: if false;
      }

      // ---- assessments (what a student was actually charged) ----
      //
      // Append-only from the client's point of view, and in fact not even
      // that: every write goes through assessStudentFees or
      // voidAssessment, because each one moves `balance` in the same
      // transaction and `balance` is server-owned. A client that could
      // write here directly could charge a family money without the
      // balance following, or move the balance without a record of why.
      //
      // Readable by the family, which is the entire point of the
      // collection: before it existed, a balance was a number with
      // nothing behind it.
      match /assessments/{assessmentId} {
        allow read: if belongsToSchool(schoolId)
                      && schoolIsAccessible(schoolId)
                      && (
                        hasRole(schoolId, ['director', 'admin'])
                        || (hasRole(schoolId, ['principal', 'registrar'])
                            && scopeAllowsStudentById(schoolId, resource.data.studentId))
                        || get(/databases/$(database)/documents/schools/$(schoolId)/students/$(resource.data.studentId)).data.userId == request.auth.uid
                        || (claims().role == 'parent'
                            && resource.data.studentId in
                               get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.linkedStudentIds)
                      );
        allow write: if false;
      }

      // ---- programs (Senior High strands + College degree programs) ----
      // Readable tenant-wide (needed by Registrar during Student
      // Registration and by Student Portal to display a student's
      // program) -- programs are institutional configuration, not
      // sensitive data. Only Director/Admin manage the catalog itself.
      match /programs/{programId} {
        allow read: if belongsToSchool(schoolId) && schoolIsAccessible(schoolId);
        allow create: if hasRole(schoolId, ['director', 'admin']) && schoolIsAccessible(schoolId);
        allow update: if hasRole(schoolId, ['director', 'admin']) && schoolIsAccessible(schoolId);
        allow delete: if false;
      }

      // Default posture for every other tenant subcollection until its
      // module is implemented: DENY by default. Every collection that
      // needs client read access must define its own explicit `allow
      // read` rule above, even if that rule is as simple as
      // `belongsToSchool(schoolId) && schoolIsAccessible(schoolId)`.
      //
      // This used to default to allowing tenant-wide read, which was a
      // real bug: Firestore grants access if ANY matching `match` block
      // allows it (logical OR across all blocks whose path pattern
      // matches the request, not "most specific wins"). A permissive
      // catch-all silently overrides every more-restrictive rule written
      // above it -- e.g. the attendance and expenses blocks' role checks
      // were being bypassed entirely by this catch-all before this fix,
      // since the catch-all's own `allow read` independently granted
      // access to any tenant member regardless of what those blocks said.
      // Deny-by-default is the only posture under which per-collection
      // restrictions actually mean anything.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Anything not explicitly matched above is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
