{
  "name": "school-saas-rules-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Firestore Security Rules test suite. Requires the Firestore emulator - see README.md.",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore,auth \"jest --config jest.config.js\"",
    "test:rules:watch": "firebase emulators:exec --only firestore,auth \"jest --config jest.config.js --watch\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/jest": "^29.5.12",
    "firebase": "^10.12.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "typescript": "^5.5.3"
  }
}
