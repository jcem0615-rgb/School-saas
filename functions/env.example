# Copy to functions/.env and fill in. .env is gitignored; this file is
# the shape of it, not a place for real values.
#
# Nothing here is required. Leave them unset and the app joins its
# video classes without a token -- which is right on a deployment that
# asks for none, and shows that deployment's own sign-in on one that
# does. Setting them is what removes the sign-in for a school; see
# docs/42-hosting-the-video.md.

# The tenant. `app_id` on a self-hosted Jitsi, the AppID on a JaaS tenant.
JITSI_APP_ID=

# Self-hosted: the matching `app_secret`, signed HS256.
# Generate with: openssl rand -hex 32
# Anyone holding this can mint entry to any lesson.
JITSI_APP_SECRET=

# JaaS instead of the above: the RSA private key, PEM, and its key id.
# Paste as it comes -- escaped newlines are put back by the reader.
JITSI_PRIVATE_KEY=
JITSI_KEY_ID=

# Where the classes are held. Must match the JITSI_DOMAIN Actions
# variable the web build uses, or every token is rejected by a server it
# was not minted for.
JITSI_DOMAIN=
